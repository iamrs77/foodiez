# Copy this file to .env:  cp .env.example .env

# Where MongoDB is. This matches "docker compose up -d db" from the project root.
MONGODB_URI=mongodb://localhost:27017/foodiez

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=1d

PORT=4000

# The web app's address, so the browser is allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Fill an empty database with demo restaurants and accounts on startup
SEED_DEMO_DATA=true
