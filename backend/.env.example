# Copy this file to .env:  cp .env.example .env

# Where MongoDB is. This matches "docker compose up -d db" from the project root.
MONGODB_URI=mongodb://localhost:27017/foodiez

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=1d

PORT=4000

# The web app's address, so the browser is allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Fill an empty database with demo restaurants and accounts on startup
SEED_DEMO_DATA=true

# Let people log in to those demo accounts with the shared password.
# A public site sets this to false, so nobody can change what everyone sees.
# DEMO_ACCOUNTS_LOGIN=true

# Let visitors create their own accounts
# SIGNUPS_ENABLED=true

# "Try the demo": each visitor gets a private copy of the demo data, deleted
# after DEMO_TTL_HOURS. At most DEMO_MAX_ACTIVE at once, and DEMO_RATE_LIMIT
# new demos per IP address per hour.
# DEMO_ENABLED=true
# DEMO_TTL_HOURS=24
# DEMO_MAX_ACTIVE=200
# DEMO_RATE_LIMIT=10

# Folder of the built web app. When set, the API serves it too, so the whole
# app runs as one service (relative to where the API is started).
# WEB_APP_DIR=../frontend/dist
