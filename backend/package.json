{
	"name": "foodiez-backend",
	"version": "2.0.0",
	"description": "REST API for Foodiez: restaurants, menus, cart and orders",
	"author": "Rohit Sharma",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"main": "src/server.js",
	"scripts": {
		"start": "node src/server.js",
		"dev": "node --watch src/server.js",
		"dev:memory": "node scripts/dev-memory.js",
		"seed": "node src/seed/run.js",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.11.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "^3.9.10",
		"supertest": "^7.3.1",
		"vitest": "^5.0.4"
	}
}
