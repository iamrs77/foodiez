# Optional. Copy to .env if you need it.

# Where the web app sends API calls. Leave it unset to use "/api", which the
# dev server passes on to http://localhost:5000 (and nginx does the same in Docker).
# VITE_API_URL=https://api.example.com/api

# Only for "npm run dev": where the dev server sends /api calls
# API_PROXY_TARGET=http://localhost:5000
